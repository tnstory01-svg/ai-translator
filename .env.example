# AI 제공사 선택: auto, anthropic, openai, gemini, openai-compatible
AI_PROVIDER=auto

# 공통 설정. AI_API_KEY를 쓰면 선택한 AI_PROVIDER의 키로 사용됩니다.
# 제공사별 키 변수(ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY)도 지원합니다.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_MAX_TOKENS=2048

# Anthropic 전용 예시
ANTHROPIC_API_KEY=sk-ant-여기에_본인_키
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI 전용 예시
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini는 Google의 OpenAI 호환 엔드포인트를 사용합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI 호환 서버(OpenRouter, Together, vLLM 등)용
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# HTML의 API 설정 저장 기능은 기본적으로 localhost에서만 허용됩니다.
# 배포 서버에서 강제로 열어야 할 때만 true로 바꾸세요.
ALLOW_ENV_WRITE=false

# 공개 배포 시 반드시 설정하세요. 로컬에서 비워두면 접속 비밀번호 없이 열립니다.
APP_PASSWORD=원하는_접속_비밀번호

# 번역 히스토리 저장 여부와 SQLite 파일 위치
SAVE_HISTORY=true
TRANSLATION_DB_PATH=data/history.sqlite3
